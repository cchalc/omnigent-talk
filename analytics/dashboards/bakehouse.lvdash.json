{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "Sales KPIs",
      "queryLines": [
        "SELECT\n",
        "  MEASURE(`Total Revenue`) AS total_revenue,\n",
        "  MEASURE(`Transaction Count`) AS transactions,\n",
        "  MEASURE(`Average Transaction Value`) AS avg_transaction_value,\n",
        "  MEASURE(`Unique Customers`) AS unique_customers\n",
        "FROM bakehouse_sales_metrics\n"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily sales",
      "queryLines": [
        "SELECT\n",
        "  `Sales Day` AS sales_day,\n",
        "  MEASURE(`Total Revenue`) AS revenue,\n",
        "  MEASURE(`Units Sold`) AS units_sold,\n",
        "  MEASURE(`Transaction Count`) AS transactions\n",
        "FROM bakehouse_sales_metrics\n",
        "GROUP BY ALL\n",
        "ORDER BY sales_day\n"
      ]
    },
    {
      "name": "ds_franchises",
      "displayName": "Top franchises",
      "queryLines": [
        "SELECT\n",
        "  concat(`Franchise Name`, ' (', `Franchise City`, ')') AS franchise,\n",
        "  `Franchise Size` AS franchise_size,\n",
        "  MEASURE(`Total Revenue`) AS revenue\n",
        "FROM bakehouse_sales_metrics\n",
        "GROUP BY ALL\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_products",
      "displayName": "Product mix",
      "queryLines": [
        "SELECT\n",
        "  `Product` AS product,\n",
        "  MEASURE(`Total Revenue`) AS revenue,\n",
        "  MEASURE(`Units Sold`) AS units_sold\n",
        "FROM bakehouse_sales_metrics\n",
        "GROUP BY ALL\n",
        "ORDER BY revenue DESC\n"
      ]
    },
    {
      "name": "ds_payments",
      "displayName": "Payment mix",
      "queryLines": [
        "SELECT\n",
        "  `Payment Method` AS payment_method,\n",
        "  MEASURE(`Total Revenue`) AS revenue,\n",
        "  MEASURE(`Transaction Count`) AS transactions\n",
        "FROM bakehouse_sales_metrics\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_sentiment",
      "displayName": "Review sentiment by city",
      "queryLines": [
        "WITH by_city AS (\n",
        "  SELECT\n",
        "    `Franchise City` AS city,\n",
        "    `Sentiment` AS sentiment,\n",
        "    MEASURE(`Review Count`) AS reviews\n",
        "  FROM bakehouse_review_metrics\n",
        "  GROUP BY ALL\n",
        "),\n",
        "top_cities AS (\n",
        "  SELECT city FROM by_city GROUP BY city ORDER BY SUM(reviews) DESC, city LIMIT 10\n",
        ")\n",
        "SELECT b.city, b.sentiment, b.reviews\n",
        "FROM by_city b JOIN top_cities t ON b.city = t.city\n",
        "ORDER BY b.city, b.sentiment\n"
      ]
    },
    {
      "name": "ds_review_kpis",
      "displayName": "Review KPIs",
      "queryLines": [
        "SELECT\n",
        "  MEASURE(`Review Count`) AS reviews,\n",
        "  MEASURE(`Positive Share`) AS positive_share\n",
        "FROM bakehouse_review_metrics\n"
      ]
    }
  ],
