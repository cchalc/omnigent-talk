{
  "datasets": [
    {
      "name": "ds_usage",
      "displayName": "Gateway usage by request tag",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('HOUR', event_time) AS event_hour,\n",
        "  coalesce(\n",
        "    nullif(request_tags['agent_spec'], ''),\n",
        "    nullif(request_tags['job'], ''),\n",
        "    '(unset)'\n",
        "  ) AS agent_spec,\n",
        "  coalesce(\n",
        "    nullif(request_tags['harness'], ''),\n",
        "    nullif(session_metadata.coding_agent, ''),\n",
        "    '(unset)'\n",
        "  ) AS harness,\n",
        "  coalesce(\n",
        "    nullif(request_tags['demo'], ''),\n",
        "    nullif(request_tags['pipeline'], ''),\n",
        "    '(unset)'\n",
        "  ) AS demo,\n",
        "  coalesce(destination_model, '(unknown)') AS destination_model,\n",
        "  count(*) AS requests,\n",
        "  sum(coalesce(input_tokens, 0)) AS input_tokens,\n",
        "  sum(coalesce(output_tokens, 0)) AS output_tokens,\n",
        "  sum(coalesce(total_tokens, 0)) AS total_tokens,\n",
        "  sum(coalesce(latency_ms, 0)) AS latency_ms_sum\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= date_sub(current_date(), :lookback_days)\n",
        "  AND service_type = 'MODEL_SERVICE'\n",
        "  AND (\n",
        "    substring_index(endpoint_name, '.', -1) IN (\n",
        "      'gemini_router', 'gemini_fast', 'gemini_general', 'qwen_code'\n",
        "    )\n",
        "    OR request_tags['demo'] = 'bakehouse'\n",
        "    OR request_tags['pipeline'] = 'bakehouse'\n",
        "    OR request_tags['job'] LIKE 'bakehouse-%'\n",
        "  )\n",
        "GROUP BY ALL\n",
        "ORDER BY event_hour DESC, requests DESC\n",
        "LIMIT 1000;\n"
      ],
      "parameters": [
        {
          "keyword": "lookback_days",
          "displayName": "Lookback days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {"dataType": "INTEGER", "values": [{"value": "7"}]}
          }
        }
      ]
    },
    {
      "name": "ds_usage_summary",
      "displayName": "Gateway usage summary",
      "queryLines": [
        "SELECT\n",
        "  count(*) AS requests,\n",
        "  sum(coalesce(total_tokens, 0)) AS total_tokens,\n",
        "  round(sum(coalesce(latency_ms, 0)) / nullif(count(latency_ms), 0)) AS avg_latency_ms\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= date_sub(current_date(), :lookback_days)\n",
        "  AND service_type = 'MODEL_SERVICE'\n",
        "  AND (\n",
        "    substring_index(endpoint_name, '.', -1) IN (\n",
        "      'gemini_router', 'gemini_fast', 'gemini_general', 'qwen_code'\n",
        "    )\n",
        "    OR request_tags['demo'] = 'bakehouse'\n",
        "    OR request_tags['pipeline'] = 'bakehouse'\n",
        "    OR request_tags['job'] LIKE 'bakehouse-%'\n",
        "  );\n"
      ],
      "parameters": [
        {
          "keyword": "lookback_days",
          "displayName": "Lookback days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {"dataType": "INTEGER", "values": [{"value": "7"}]}
          }
        }
      ]
    },
    {
      "name": "ds_cost",
      "displayName": "External model spend by request tag",
      "queryLines": [
        "WITH token_usage AS (\n",
        "  SELECT\n",
        "    CAST(event_time AS DATE) AS usage_date,\n",
        "    coalesce(\n",
        "      nullif(request_tags['harness'], ''),\n",
        "      nullif(session_metadata.coding_agent, ''),\n",
        "      nullif(request_tags['agent_spec'], ''),\n",
        "      nullif(request_tags['job'], ''),\n",
        "      '(unset)'\n",
        "    ) AS harness,\n",
        "    count(*) AS requests,\n",
        "    sum(coalesce(total_tokens, 0)) AS total_tokens\n",
        "  FROM system.ai_gateway.usage\n",
        "  WHERE event_time >= date_sub(current_date(), :lookback_days)\n",
        "    AND service_type = 'MODEL_SERVICE'\n",
        "    AND (\n",
        "      substring_index(endpoint_name, '.', -1) IN (\n",
        "        'gemini_router', 'gemini_fast', 'gemini_general', 'qwen_code'\n",
        "      )\n",
        "      OR request_tags['demo'] = 'bakehouse'\n",
        "      OR request_tags['pipeline'] = 'bakehouse'\n",
        "      OR request_tags['job'] LIKE 'bakehouse-%'\n",
        "    )\n",
        "  GROUP BY ALL\n",
        "),\n",
        "external_cost AS (\n",
        "  SELECT\n",
        "    usage_date,\n",
        "    coalesce(\n",
        "      nullif(custom_tags.request_tags['harness'], ''),\n",
        "      nullif(custom_tags.request_tags['agent_spec'], ''),\n",
        "      nullif(custom_tags.request_tags['job'], ''),\n",
        "      '(unset)'\n",
        "    ) AS harness,\n",
        "    sum(usage_quantity) AS external_cost_usd\n",
        "  FROM system.ai_gateway.external_model_spend\n",
        "  WHERE usage_date >= date_sub(current_date(), :lookback_days)\n",
        "    AND (\n",
        "      substring_index(usage_metadata.endpoint_name, '.', -1) IN (\n",
        "        'gemini_router', 'gemini_fast', 'gemini_general', 'qwen_code'\n",
        "      )\n",
        "      OR custom_tags.request_tags['demo'] = 'bakehouse'\n",
        "      OR custom_tags.request_tags['pipeline'] = 'bakehouse'\n",
        "      OR custom_tags.request_tags['job'] LIKE 'bakehouse-%'\n",
        "    )\n",
        "  GROUP BY ALL\n",
        ")\n",
        "SELECT\n",
        "  coalesce(t.usage_date, c.usage_date) AS usage_date,\n",
        "  coalesce(t.harness, c.harness) AS harness,\n",
        "  coalesce(t.requests, 0) AS requests,\n",
        "  coalesce(t.total_tokens, 0) AS total_tokens,\n",
        "  round(c.external_cost_usd, 6) AS external_cost_usd\n",
        "FROM token_usage AS t\n",
        "FULL OUTER JOIN external_cost AS c\n",
        "  ON t.usage_date = c.usage_date\n",
        "  AND t.harness = c.harness\n",
        "ORDER BY usage_date DESC, requests DESC\n",
        "LIMIT 1000;\n"
      ],
      "parameters": [
        {
          "keyword": "lookback_days",
          "displayName": "Lookback days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {"dataType": "INTEGER", "values": [{"value": "7"}]}
          }
        }
      ]
    },
    {
      "name": "ds_routing",
      "displayName": "gemini_router split and fallback attempts",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('HOUR', event_time) AS event_hour,\n",
        "  coalesce(destination_model, '(unknown)') AS destination_model,\n",
        "  count(*) AS requests,\n",
        "  sum(CASE WHEN size(routing_information.attempts) > 1 THEN 1 ELSE 0 END) AS fallbacks,\n",
        "  sum(CASE WHEN status_code >= 400 THEN 1 ELSE 0 END) AS failed_requests,\n",
        "  round(avg(latency_ms)) AS avg_latency_ms,\n",
        "  sum(coalesce(total_tokens, 0)) AS total_tokens\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= date_sub(current_date(), :lookback_days)\n",
        "  AND service_type = 'MODEL_SERVICE'\n",
        "  AND substring_index(endpoint_name, '.', -1) = 'gemini_router'\n",
        "GROUP BY ALL\n",
        "ORDER BY event_hour DESC, requests DESC\n",
        "LIMIT 1000;\n"
      ],
      "parameters": [
        {
          "keyword": "lookback_days",
          "displayName": "Lookback days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {"dataType": "INTEGER", "values": [{"value": "7"}]}
          }
        }
      ]
    },
    {
      "name": "ds_table_lineage",
      "displayName": "Bakehouse table lineage",
      "queryLines": [
        "SELECT\n",
        "  max(event_time) AS last_seen,\n",
        "  CASE\n",
        "    WHEN entity_metadata.genie_space_id IS NOT NULL THEN 'GENIE'\n",
        "    ELSE coalesce(nullif(entity_type, ''), 'DIRECT')\n",
        "  END AS observed_entity_type,\n",
        "  concat(source_table_schema, '.', source_table_name) AS source_object,\n",
        "  source_type,\n",
        "  concat(target_table_schema, '.', target_table_name) AS target_object,\n",
        "  target_type,\n",
        "  count(*) AS lineage_events\n",
        "FROM system.access.table_lineage\n",
        "WHERE event_date >= date_sub(current_date(), :lookback_days)\n",
        "  AND (\n",
        "    (\n",
        "      source_table_catalog = coalesce(nullif(:catalog, ''), current_catalog())\n",
        "      AND source_table_schema = coalesce(nullif(:schema, ''), current_schema())\n",
        "      AND lower(coalesce(source_table_name, '')) LIKE 'bakehouse\\_%' ESCAPE '\\\\'\n",
        "    )\n",
        "    OR (\n",
        "      target_table_catalog = coalesce(nullif(:catalog, ''), current_catalog())\n",
        "      AND target_table_schema = coalesce(nullif(:schema, ''), current_schema())\n",
        "      AND lower(coalesce(target_table_name, '')) LIKE 'bakehouse\\_%' ESCAPE '\\\\'\n",
        "    )\n",
        "  )\n",
        "GROUP BY ALL\n",
        "ORDER BY last_seen DESC\n",
        "LIMIT 1000;\n"
      ],
      "parameters": [
        {
          "keyword": "lookback_days",
          "displayName": "Lookback days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {"dataType": "INTEGER", "values": [{"value": "30"}]}
          }
        },
        {
          "keyword": "catalog",
          "displayName": "Catalog scope",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": ""}]}
          }
        },
        {
          "keyword": "schema",
          "displayName": "Schema scope",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": ""}]}
          }
        }
      ]
    },
    {
      "name": "ds_column_lineage",
      "displayName": "Bakehouse column lineage",
      "queryLines": [
        "SELECT\n",
        "  max(event_time) AS last_seen,\n",
        "  CASE\n",
        "    WHEN entity_metadata.genie_space_id IS NOT NULL THEN 'GENIE'\n",
        "    ELSE coalesce(nullif(entity_type, ''), 'DIRECT')\n",
        "  END AS observed_entity_type,\n",
        "  concat(source_table_schema, '.', source_table_name) AS source_object,\n",
        "  source_column_name,\n",
        "  concat(target_table_schema, '.', target_table_name) AS target_object,\n",
        "  target_column_name,\n",
        "  count(*) AS mapping_events\n",
        "FROM system.access.column_lineage\n",
        "WHERE event_date >= date_sub(current_date(), :lookback_days)\n",
        "  AND (\n",
        "    (\n",
        "      source_table_catalog = coalesce(nullif(:catalog, ''), current_catalog())\n",
        "      AND source_table_schema = coalesce(nullif(:schema, ''), current_schema())\n",
        "      AND lower(coalesce(source_table_name, '')) LIKE 'bakehouse\\_%' ESCAPE '\\\\'\n",
        "    )\n",
        "    OR (\n",
        "      target_table_catalog = coalesce(nullif(:catalog, ''), current_catalog())\n",
        "      AND target_table_schema = coalesce(nullif(:schema, ''), current_schema())\n",
        "      AND lower(coalesce(target_table_name, '')) LIKE 'bakehouse\\_%' ESCAPE '\\\\'\n",
        "    )\n",
        "  )\n",
        "GROUP BY ALL\n",
        "ORDER BY last_seen DESC\n",
        "LIMIT 1000;\n"
      ],
      "parameters": [
        {
          "keyword": "lookback_days",
          "displayName": "Lookback days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {"dataType": "INTEGER", "values": [{"value": "30"}]}
          }
        },
        {
          "keyword": "catalog",
          "displayName": "Catalog scope",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": ""}]}
          }
        },
        {
          "keyword": "schema",
          "displayName": "Schema scope",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {"dataType": "STRING", "values": [{"value": ""}]}
          }
        }
      ]
    }
  ],
