{
  "datasets": [
    {
      "name": "ds_usage",
      "displayName": "Gateway usage by request tag",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('HOUR', event_time) AS event_hour,\n",
        "  coalesce(request_tags['agent_spec'], '(unset)') AS agent_spec,\n",
        "  coalesce(request_tags['harness'], '(unset)') AS harness,\n",
        "  coalesce(request_tags['demo'], '(unset)') AS demo,\n",
        "  coalesce(destination_model, '(unknown)') AS destination_model,\n",
        "  count(*) AS requests,\n",
        "  sum(coalesce(total_tokens, 0)) AS total_tokens,\n",
        "  round(avg(latency_ms)) AS avg_latency_ms\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= date_sub(current_date(), 7)\n",
        "GROUP BY ALL\n",
        "ORDER BY event_hour DESC, requests DESC\n"
      ]
    },
    {
      "name": "ds_cost",
      "displayName": "External model spend by request tag",
      "queryLines": [
        "SELECT\n",
        "  usage_start_time AS event_hour,\n",
        "  coalesce(custom_tags.request_tags['agent_spec'], '(unset)') AS agent_spec,\n",
        "  coalesce(custom_tags.request_tags['harness'], '(unset)') AS harness,\n",
        "  coalesce(custom_tags.request_tags['demo'], '(unset)') AS demo,\n",
        "  coalesce(usage_metadata.model, '(unknown)') AS destination_model,\n",
        "  sum(usage_quantity) AS external_cost_usd\n",
        "FROM system.ai_gateway.external_model_spend\n",
        "WHERE usage_date >= date_sub(current_date(), 7)\n",
        "GROUP BY ALL\n",
        "ORDER BY event_hour DESC\n"
      ]
    },
    {
      "name": "ds_routing",
      "displayName": "gemini_router split and fallback attempts",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('HOUR', event_time) AS event_hour,\n",
        "  coalesce(destination_model, '(unknown)') AS destination_model,\n",
        "  count(*) AS requests,\n",
        "  sum(CASE WHEN size(routing_information.attempts) > 1 THEN 1 ELSE 0 END) AS fallbacks,\n",
        "  sum(CASE WHEN status_code >= 400 THEN 1 ELSE 0 END) AS failed_requests,\n",
        "  round(avg(latency_ms)) AS avg_latency_ms\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= date_sub(current_date(), 7)\n",
        "  AND substring_index(endpoint_name, '.', -1) = 'gemini_router'\n",
        "GROUP BY ALL\n",
        "ORDER BY event_hour DESC, requests DESC\n"
      ]
    },
    {
      "name": "ds_table_lineage",
      "displayName": "Bakehouse table lineage",
      "queryLines": [
        "SELECT\n",
        "  max(event_time) AS last_seen,\n",
        "  CASE WHEN entity_metadata.genie_space_id IS NOT NULL THEN 'GENIE' ELSE coalesce(entity_type, 'DIRECT') END AS observed_entity_type,\n",
        "  source_table_full_name,\n",
        "  source_type,\n",
        "  target_table_full_name,\n",
        "  target_type,\n",
        "  count(*) AS edges\n",
        "FROM system.access.table_lineage\n",
        "WHERE event_date >= date_sub(current_date(), 30)\n",
        "  AND (lower(coalesce(source_table_full_name, '')) LIKE '%.omnigent_talk.bakehouse\\_%' ESCAPE '\\\\'\n",
        "    OR lower(coalesce(target_table_full_name, '')) LIKE '%.omnigent_talk.bakehouse\\_%' ESCAPE '\\\\')\n",
        "GROUP BY ALL\n",
        "ORDER BY last_seen DESC\n",
        "LIMIT 1000\n"
      ]
    },
    {
      "name": "ds_column_lineage",
      "displayName": "Bakehouse column lineage",
      "queryLines": [
        "SELECT\n",
        "  max(event_time) AS last_seen,\n",
        "  CASE WHEN entity_metadata.genie_space_id IS NOT NULL THEN 'GENIE' ELSE coalesce(entity_type, 'DIRECT') END AS observed_entity_type,\n",
        "  source_table_full_name,\n",
        "  source_column_name,\n",
        "  target_table_full_name,\n",
        "  target_column_name,\n",
        "  count(*) AS mappings\n",
        "FROM system.access.column_lineage\n",
        "WHERE event_date >= date_sub(current_date(), 30)\n",
        "  AND (lower(coalesce(source_table_full_name, '')) LIKE '%.omnigent_talk.bakehouse\\_%' ESCAPE '\\\\'\n",
        "    OR lower(coalesce(target_table_full_name, '')) LIKE '%.omnigent_talk.bakehouse\\_%' ESCAPE '\\\\')\n",
        "GROUP BY ALL\n",
        "ORDER BY last_seen DESC\n",
        "LIMIT 1000\n"
      ]
    }
  ],
