{
  "datasets": [
    {
      "name": "ds_usage",
      "displayName": "Demo service usage",
      "queryLines": [
        "SELECT\n",
        "  event_time,\n",
        "  date_trunc('MINUTE', event_time) AS minute,\n",
        "  substring_index(endpoint_name, '.', -1) AS service,\n",
        "  destination_model,\n",
        "  coalesce(request_tags['route'], '(none)') AS route,\n",
        "  coalesce(request_tags['demo'], '(untagged)') AS demo,\n",
        "  coalesce(request_tags['stage'], '') AS stage,\n",
        "  status_code,\n",
        "  size(routing_information.attempts) AS attempts,\n",
        "  CASE WHEN size(routing_information.attempts) > 1 THEN 1 ELSE 0 END AS fell_back,\n",
        "  CASE WHEN destination_model LIKE '%qwen%' THEN 1 ELSE 0 END AS served_by_qwen,\n",
        "  latency_ms,\n",
        "  total_tokens\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE endpoint_name LIKE '%.omnigent_talk.%'\n",
        "  AND event_time >= date_sub(current_date(), 7)\n",
        "ORDER BY event_time DESC\n"
      ]
    },
    {
      "name": "ds_router",
      "displayName": "Router decisions",
      "queryLines": [
        "SELECT\n",
        "  event_time,\n",
        "  date_trunc('MINUTE', event_time) AS minute,\n",
        "  substring_index(endpoint_name, '.', -1) AS service,\n",
        "  destination_model,\n",
        "  coalesce(request_tags['route'], '(none)') AS route,\n",
        "  coalesce(request_tags['demo'], '(untagged)') AS demo,\n",
        "  coalesce(request_tags['stage'], '') AS stage,\n",
        "  status_code,\n",
        "  size(routing_information.attempts) AS attempts,\n",
        "  CASE WHEN size(routing_information.attempts) > 1 THEN 1 ELSE 0 END AS fell_back,\n",
        "  CASE WHEN destination_model LIKE '%qwen%' THEN 1 ELSE 0 END AS served_by_qwen,\n",
        "  latency_ms,\n",
        "  total_tokens\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE endpoint_name LIKE '%.omnigent_talk.%'\n",
        "  AND event_time >= date_sub(current_date(), 7)\n",
        "  AND request_tags['stage'] = 'answer'\n"
      ]
    }
  ],
  "pages": [
