# Copy to .env.local (gitignored) and fill in. `just` loads it. Names only here: the repo is public.
DBX_PROFILE=            # Databricks CLI profile for the demo workspace (presenter chooses)
CATALOG=                # catalog holding the demo schema (needs CREATE SCHEMA / CREATE SERVICE)
SCHEMA=omnigent_talk    # schema for model services and inference tables
REQUESTS_PER_MINUTE=30  # gemini_router per-user limit; raise for live agy, lower for the 429 demo
OMNI_SERVER=            # Omnigent server URL; never commit it
MEMORY_STORE=omnigent-talk-memory   # managed agent memory store id (3-56 chars, lowercase)
WAREHOUSE_ID=           # SQL warehouse for usage queries
