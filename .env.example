# Copy to .env.local (gitignored) and fill in. `just` loads it. Names only here: the repo is public.
DBX_PROFILE=            # Databricks CLI profile for the demo workspace (presenter chooses)
CATALOG=                # catalog holding the demo schema (needs CREATE SCHEMA / CREATE SERVICE)
SCHEMA=omnigent_talk    # schema for model services and inference tables
OMNI_SERVER=            # Omnigent server URL; never commit it
MEMORY_STORE=omnigent-talk-memory   # managed agent memory store id (3-56 chars, lowercase)
WAREHOUSE_ID=           # no recipe reads this yet
BEHAVIOR_EVAL_EXPERIMENT= # Databricks MLflow experiment path for agent behavior evaluation
BEHAVIOR_JUDGE_MODEL=     # Judge URI, for example databricks:/<model-service>
OMNIGENT_CONFIG_HOME=    # Isolated Omnigent config dir for this workspace; absolute path, never ~/.omnigent
OMNIGENT_DATA_DIR=       # Same dir as OMNIGENT_CONFIG_HOME: tokens, host daemon, logs (read by omni)
SHIM_PORT=               # Local port for `just agy-serve` (read by cli.py); any free port
SHIM_KEY=                # Local key for the shim (read by cli.py); a random string you make up
GEMINI_MODEL=            # Main Gemini service, for example system.ai.<gemini-model>; no recipe reads it yet
GEMINI_FLASH_MODEL=      # Cheaper Gemini for contrast; no recipe reads it yet
DBX_GCP_PROFILE=         # Optional GCP workspace profile for Gemini and memory demos; no recipe reads it yet
